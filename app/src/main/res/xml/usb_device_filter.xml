<!--
  Filtro do intent USB_DEVICE_ATTACHED: abre o app quando um aparelho com
  interface ADB (classe 0xFF, subclasse 0x42) ou fastboot (protocolo 0x03)
  é conectado. O Android não filtra por classe/subclasse no XML, então o
  filtro é amplo e o app verifica a interface em runtime (AdbUsb/FastbootUsb).
-->
<resources>
    <!-- Fabricantes comuns: Google, Samsung, Xiaomi, Motorola, OnePlus, Sony,
         LG, Huawei, Oppo/Realme, Vivo, Asus, Nokia, Fairphone, Nothing… -->
    <usb-device vendor-id="6353" />   <!-- Google -->
    <usb-device vendor-id="1256" />   <!-- Samsung -->
    <usb-device vendor-id="2717" />   <!-- Xiaomi -->
    <usb-device vendor-id="2996" />   <!-- Xiaomi/POCO -->
