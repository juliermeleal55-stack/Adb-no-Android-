<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ADB sem fio (Wi‑Fi) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Manter a comunicação durante transferências longas -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Wi‑Fi: descobrir o IP do aparelho para o "adb connect" -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- USB Host (OTG). Opcional: sem OTG o app funciona por Wi‑Fi. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!--
      Sem exigir tela touch/multitouch: tablets e TVs com OTG funcionam.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ADB no Android"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.AdbNoAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Conectar direto ao plugar um aparelho USB (abre o app) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- Plugue/remoção de USB e resultado do pedido de permissão -->
        <receiver
            android:name=".UsbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
                <action android:name="com.adbnoandroid.USB_PERMISSION" />
            </intent-filter>
        </receiver>

        <!-- Compartilhar logs/arquivos (WhatsApp, e-mail, Drive…) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.adbnoandroid.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
